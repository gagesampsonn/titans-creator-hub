# ============================================
# TITANS CREATOR HUB - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# 
# For Vercel deployment, add these in:
# Vercel Dashboard > Project > Settings > Environment Variables

# ============================================
# GOOGLE GEMINI AI
# ============================================
GEMINI_API_KEY=your-gemini-api-key

# ============================================
# SUPABASE - Frontend (Safe to expose via VITE_)
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# SUPABASE - Backend ONLY (Never expose!)
# Get from: Supabase Dashboard > Settings > API > service_role
# ============================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# TIKTOK SHOP PARTNER CENTER - Backend ONLY
# Get from: TikTok Shop Partner Center > My Apps > Your App
# ⚠️ NEVER expose APP_SECRET in frontend code!
# ============================================
TIKTOK_APP_KEY=your-app-key
TIKTOK_APP_SECRET=your-app-secret

# OAuth Redirect URL - MUST match what's configured in TikTok Partner Center
# Use the /authorize endpoint which rewrites to /api/tiktok/callback
TIKTOK_REDIRECT_URL=https://www.titansagency.co/authorize

# ============================================
# TIKTOK PARTNER IDS - Backend ONLY
# These are your registered partner IDs in TikTok Shop Partner Center
# Get from: Partner Center > Account Settings
# ============================================

# CAP (Creator Agency Partner) - For linking creators and accessing their data
TIKTOK_CAP_AGENCY_ID=your-cap-agency-id

# TAP (TikTok Affiliate Partner) - For creating increased commission offers
TIKTOK_TAP_PARTNER_ID=your-tap-partner-id

# TSP (TikTok Shop Partner) - For seller-level services (optional)
TIKTOK_TSP_PARTNER_ID=your-tsp-partner-id

# CAP binding callback (where creators are redirected after accepting)
TIKTOK_CAP_CALLBACK_URL=https://www.titansagency.co/dashboard?cap=linked

# ============================================
# APP CONFIGURATION
# ============================================
FRONTEND_URL=https://www.titansagency.co
