# ============================================
# TITANS CREATOR HUB - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# GOOGLE GEMINI AI
# ============================================
GEMINI_API_KEY=your-gemini-api-key

# ============================================
# SUPABASE - Frontend (Safe to expose via VITE_)
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# SUPABASE - Backend ONLY (Never expose!)
# Get from: Supabase Dashboard > Settings > API > service_role
# ============================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# TIKTOK SHOP PARTNER CENTER - Backend ONLY
# Get from: TikTok Partner Center > App Management
# ⚠️ NEVER expose APP_SECRET in frontend code!
# ============================================
TIKTOK_APP_KEY=your-app-key
TIKTOK_APP_SECRET=your-app-secret
TIKTOK_REDIRECT_URL=https://your-domain.com/api/tiktok/callback

# ============================================
# APP CONFIGURATION
# ============================================
FRONTEND_URL=https://your-domain.com
